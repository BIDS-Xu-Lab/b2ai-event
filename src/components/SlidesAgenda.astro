---
import { agenda, driveUrl } from '../data/slides';

const days = [...new Set(agenda.map((s) => s.day))];
---
<section class="section" id="slides">
  <div class="container">
    <header class="section-head" data-reveal>
      <span class="section-eyebrow">Presentations</span>
      <h2 class="section-title">Open Session Slides</h2>
      <p class="section-sub">
        Click on the agenda items from the open sessions of the 2026 Fall Bridge2AI Conference to view the slides presented (PDF).
      </p>
    </header>

    {days.map((day) => (
      <div class="day">
        <h3 class="day-label">{day}</h3>
        {agenda.filter((s) => s.day === day).map((session) => (
          <div class="session" data-reveal>
            <h4 class="session-title">{session.title}</h4>
            <ul class="talks">
              {session.talks.map((talk) => (
                <li>
                  {talk.driveId ? (
                    <a class="talk" href={driveUrl(talk.driveId)} target="_blank" rel="noopener noreferrer">
                      <span class="talk-text">
                        <span class="talk-title">{talk.title}</span>
                        <span class="talk-speakers">{talk.speakers}</span>
                      </span>
                      <span class="talk-pdf" aria-label="View PDF slides">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                      </span>
                    </a>
                  ) : (
                    <div class="talk talk--pending">
                      <span class="talk-text">
                        <span class="talk-title">{talk.title}</span>
                        <span class="talk-speakers">{talk.speakers}</span>
                      </span>
                      <span class="talk-soon">Coming soon</span>
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    ))}
  </div>
</section>

<style>
  #slides { scroll-margin-top: 72px; }
  .section-head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: var(--space-6);
  }
  #slides .section-sub { max-width: none; font-size: 1.1875rem; }
  .day + .day { margin-top: var(--space-7); }
  .day-label {
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--b2ai-royal);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-5);
    border-bottom: 2px solid var(--b2ai-border);
  }
  .session + .session { margin-top: var(--space-6); }
  .session-title {
    font-size: 1.625rem;
    font-weight: 600;
    color: var(--b2ai-ink);
    margin-bottom: var(--space-3);
  }
  .talks {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .talk {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: 100%;
    padding: 1rem 1.25rem;
    background: var(--b2ai-surface);
    border: 1px solid var(--b2ai-border);
    border-radius: 14px;
    color: inherit;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  a.talk:hover {
    border-color: var(--b2ai-border-strong);
    box-shadow: 0 8px 22px rgba(46, 26, 77, 0.08);
    transform: translateY(-1px);
    color: inherit;
  }
  .talk-text { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .talk-title { font-size: 1.1875rem; font-weight: 600; color: var(--b2ai-ink); line-height: 1.4; }
  a.talk:hover .talk-title { color: var(--b2ai-royal); }
  .talk-speakers { font-size: var(--text-md); color: var(--b2ai-text-muted); }
  .talk-pdf {
    flex-shrink: 0;
    display: inline-flex;
    color: var(--b2ai-text-muted);
    transition: color 0.15s;
  }
  a.talk:hover .talk-pdf { color: var(--b2ai-royal); }
  .talk--pending { background: var(--b2ai-bg); border-style: dashed; }
  .talk-soon {
    flex-shrink: 0;
    font-size: var(--text-md);
    color: var(--b2ai-text-muted);
    font-style: italic;
  }

  @media (max-width: 760px) {
    .talks { grid-template-columns: 1fr; }
  }
</style>
